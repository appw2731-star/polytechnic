rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all unspecified paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Global Hardened Primitives
    // -----------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'facebook.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          request.auth.token.email == 'webrokib@gmail.com'
        );
    }

    function isValidDepartment(dept) {
      return dept is string && dept.size() >= 2 && dept.size() <= 40 && dept.matches('^[a-z0-9_\\-]+$');
    }

    function isValidSemester(sem) {
      return sem is int && sem >= 1 && sem <= 8;
    }

    // -----------------------------------------------------------------------
    // Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    // -----------------------------------------------------------------------
    function isValidUserProfile(data, pathUserId) {
      return data.keys().hasAll([
        'uid', 'fullName', 'email', 'department', 'semester', 'role', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'fullName', 'email', 'department', 'semester',
        'collegeName', 'rollNumber', 'bio', 'avatarUrl', 'coverUrl',
        'gender', 'showGender', 'profileVisibility', 'authProvider',
        'role', 'isDisabled', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == pathUserId &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
      data.email is string && data.email.size() <= 160 &&
      isValidDepartment(data.department) &&
      isValidSemester(data.semester) &&
      (!('collegeName' in data) || (data.collegeName is string && data.collegeName.size() <= 160)) &&
      (!('rollNumber' in data) || (data.rollNumber is string && data.rollNumber.size() <= 40)) &&
      (!('bio' in data) || (data.bio is string && data.bio.size() <= 400)) &&
      (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 250000)) &&
      (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 350000)) &&
      (!('gender' in data) || (data.gender in ['', 'male', 'female'])) &&
      (!('showGender' in data) || data.showGender is bool) &&
      (!('profileVisibility' in data) || (data.profileVisibility in ['public', 'department', 'private'])) &&
      (!('authProvider' in data) || (data.authProvider in ['google', 'facebook', 'email'])) &&
      (data.role == 'student' || data.role == 'admin') &&
      (!('isDisabled' in data) || data.isDisabled is bool) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, pathUserId) {
      return data.keys().hasAll([
        'uid', 'fullName', 'department', 'semester', 'role', 'profileVisibility', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'fullName', 'department', 'semester',
        'collegeName', 'bio', 'avatarUrl', 'coverUrl',
        'role', 'profileVisibility', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == pathUserId &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
      isValidDepartment(data.department) &&
      isValidSemester(data.semester) &&
      (!('collegeName' in data) || (data.collegeName is string && data.collegeName.size() <= 160)) &&
      (!('bio' in data) || (data.bio is string && data.bio.size() <= 400)) &&
      (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 250000)) &&
      (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 350000)) &&
      (data.role == 'student' || data.role == 'admin') &&
      (data.profileVisibility in ['public', 'department', 'private']) &&
      data.updatedAt is timestamp;
    }

    function isValidCommunityPost(data, postId) {
      return data.keys().hasAll([
        'id', 'authorId', 'authorName', 'department', 'semester',
        'title', 'body', 'likedByUserIds', 'replies', 'isHidden',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'authorId', 'authorName', 'authorAvatarUrl', 'authorCollegeName',
        'authorDepartment', 'authorRole', 'department', 'semester', 'subjectTag',
        'title', 'body', 'imageUrl', 'likedByUserIds', 'replies', 'isHidden',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id == postId &&
      isValidId(data.authorId) &&
      data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
      (!('authorAvatarUrl' in data) || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 250000)) &&
      (!('authorCollegeName' in data) || (data.authorCollegeName is string && data.authorCollegeName.size() <= 160)) &&
      (!('authorDepartment' in data) || isValidDepartment(data.authorDepartment)) &&
      (!('authorRole' in data) || (data.authorRole == 'student' || data.authorRole == 'admin')) &&
      isValidDepartment(data.department) &&
      isValidSemester(data.semester) &&
      (!('subjectTag' in data) || (data.subjectTag is string && data.subjectTag.size() <= 60)) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.body is string && data.body.size() <= 4000 &&
      (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 450000)) &&
      data.likedByUserIds is list && data.likedByUserIds.size() <= 500 &&
      (data.likedByUserIds.size() == 0 || data.likedByUserIds[0] is string) &&
      data.replies is list && data.replies.size() <= 100 &&
      (data.replies.size() == 0 || data.replies[0] is map) &&
      data.isHidden is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPersonalStudyNote(data, pathUserId, noteId) {
      return data.keys().hasAll([
        'id', 'userId', 'title', 'content', 'department', 'semester', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'title', 'content', 'subjectName', 'department', 'semester', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id == noteId &&
      isValidId(data.userId) &&
      data.userId == pathUserId &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
      data.content is string && data.content.size() >= 1 && data.content.size() <= 12000 &&
      (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 120)) &&
      isValidDepartment(data.department) &&
      isValidSemester(data.semester) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPersonalPdfMetadata(data, pathUserId, pdfId) {
      return data.keys().hasAll([
        'id', 'userId', 'customName', 'fileName', 'department', 'semester', 'fileSizeBytes', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'customName', 'fileName', 'department', 'semester', 'subjectCode', 'fileSizeBytes', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id == pdfId &&
      isValidId(data.userId) &&
      data.userId == pathUserId &&
      data.customName is string && data.customName.size() >= 1 && data.customName.size() <= 180 &&
      data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
      isValidDepartment(data.department) &&
      isValidSemester(data.semester) &&
      (!('subjectCode' in data) || (data.subjectCode is string && data.subjectCode.size() <= 40)) &&
      data.fileSizeBytes is int && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 52428800 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data, pathUserId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
      isValidId(data.uid) &&
      data.uid == pathUserId &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.grantedAt is timestamp;
    }

    function isValidPlatformNotice(data, noticeId) {
      return data.keys().hasAll([
        'id', 'title', 'body', 'category', 'pinned', 'createdBy', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'body', 'category', 'officialLink', 'pinned', 'createdBy', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.id == noticeId &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 180 &&
      data.body is string && data.body.size() >= 2 && data.body.size() <= 4000 &&
      (data.category in ['general', 'exam', 'result', 'urgent']) &&
      (!('officialLink' in data) || (data.officialLink is string && data.officialLink.size() <= 500)) &&
      data.pinned is bool &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp;
    }

    function isValidPushNotificationCampaign(data, campaignId) {
      return data.keys().hasAll([
        'id', 'title', 'body', 'category', 'audienceType', 'targetUserIds',
        'soundMode', 'status', 'totalRecipients', 'createdBy', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'body', 'category', 'imageUrl', 'targetView', 'actionUrl',
        'audienceType', 'targetUserIds', 'targetDepartment', 'targetSemester',
        'soundMode', 'status', 'totalRecipients', 'createdBy', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.id == campaignId &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
      data.body is string && data.body.size() >= 2 && data.body.size() <= 1000 &&
      (data.category in ['APP_UPDATE', 'IMPORTANT', 'EDUCATION', 'EMERGENCY', 'GENERAL']) &&
      (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500)) &&
      (!('targetView' in data) || (data.targetView is string && data.targetView.size() <= 60)) &&
      (!('actionUrl' in data) || (data.actionUrl is string && data.actionUrl.size() <= 500)) &&
      (data.audienceType in ['all', 'selected_users', 'department_semester']) &&
      data.targetUserIds is list && data.targetUserIds.size() <= 200 &&
      (data.targetUserIds.size() == 0 || data.targetUserIds[0] is string) &&
      (!('targetDepartment' in data) || (data.targetDepartment is string && data.targetDepartment.size() <= 40)) &&
      (!('targetSemester' in data) || (data.targetSemester is int && data.targetSemester >= 0 && data.targetSemester <= 8)) &&
      (data.soundMode in ['custom', 'default', 'silent']) &&
      (data.status in ['sent', 'partial', 'failed']) &&
      data.totalRecipients is int && data.totalRecipients >= 0 && data.totalRecipients <= 100000 &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp;
    }

    function isValidPlatformFormula(data, formulaId) {
      return data.keys().hasAll([
        'id', 'subject', 'chapter', 'nameEn', 'expressionLatex', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'subject', 'chapter', 'chapterBn', 'nameEn', 'nameBn',
        'expressionLatex', 'expressionPlain', 'explanationBn', 'explanationEn',
        'exampleProblemBn', 'exampleProblemEn', 'exampleSolutionBn', 'exampleSolutionEn',
        'isCustom', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id == formulaId &&
      (data.subject in ['physics', 'mathematics']) &&
      data.chapter is string && data.chapter.size() >= 1 && data.chapter.size() <= 100 &&
      (!('chapterBn' in data) || (data.chapterBn is string && data.chapterBn.size() <= 140)) &&
      data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 180 &&
      (!('nameBn' in data) || (data.nameBn is string && data.nameBn.size() <= 180)) &&
      data.expressionLatex is string && data.expressionLatex.size() >= 1 && data.expressionLatex.size() <= 500 &&
      (!('expressionPlain' in data) || (data.expressionPlain is string && data.expressionPlain.size() <= 500)) &&
      (!('explanationBn' in data) || (data.explanationBn is string && data.explanationBn.size() <= 2000)) &&
      (!('explanationEn' in data) || (data.explanationEn is string && data.explanationEn.size() <= 2000)) &&
      (!('exampleProblemBn' in data) || (data.exampleProblemBn is string && data.exampleProblemBn.size() <= 1500)) &&
      (!('exampleProblemEn' in data) || (data.exampleProblemEn is string && data.exampleProblemEn.size() <= 1500)) &&
      (!('exampleSolutionBn' in data) || (data.exampleSolutionBn is string && data.exampleSolutionBn.size() <= 2000)) &&
      (!('exampleSolutionEn' in data) || (data.exampleSolutionEn is string && data.exampleSolutionEn.size() <= 2000)) &&
      (!('isCustom' in data) || data.isCustom is bool) &&
      data.updatedAt is timestamp;
    }

    function isValidPlatformSharedNote(data, noteId) {
      return data.keys().hasAll([
        'id', 'title', 'department', 'semester', 'pdfUrl', 'downloadPermitted', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'department', 'semester', 'subjectCode', 'summary',
        'pdfUrl', 'downloadPermitted', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.id == noteId &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
      isValidDepartment(data.department) &&
      isValidSemester(data.semester) &&
      (!('subjectCode' in data) || (data.subjectCode is string && data.subjectCode.size() <= 40)) &&
      (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000)) &&
      data.pdfUrl is string && data.pdfUrl.size() <= 1000 &&
      data.downloadPermitted is bool &&
      data.createdAt is timestamp;
    }

    function isValidPlatformMcq(data, mcqId) {
      return data.keys().hasAll([
        'id', 'category', 'department', 'semester', 'questionBn', 'optionsBn', 'correctIndex', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'category', 'department', 'semester', 'questionBn', 'optionsBn',
        'correctIndex', 'explanationBn', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.id == mcqId &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
      isValidDepartment(data.department) &&
      isValidSemester(data.semester) &&
      data.questionBn is string && data.questionBn.size() >= 2 && data.questionBn.size() <= 600 &&
      data.optionsBn is list && data.optionsBn.size() == 4 &&
      data.optionsBn[0] is string && data.optionsBn[1] is string &&
      data.optionsBn[2] is string && data.optionsBn[3] is string &&
      data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex <= 3 &&
      (!('explanationBn' in data) || (data.explanationBn is string && data.explanationBn.size() <= 1200)) &&
      data.createdAt is timestamp;
    }

    function isValidPlatformAppConfig(data) {
      return data.keys().hasAll([
        'appVersion', 'apkStatus', 'btebResultUrl', 'officialWebsiteUrl', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'appVersion', 'apkStatus', 'apkDownloadUrl', 'apkReleaseNotes',
        'btebResultUrl', 'officialWebsiteUrl', 'updatedAt'
      ]) &&
      data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 40 &&
      (data.apkStatus in ['coming_soon', 'available']) &&
      (!('apkDownloadUrl' in data) || (data.apkDownloadUrl is string && data.apkDownloadUrl.size() <= 600)) &&
      (!('apkReleaseNotes' in data) || (data.apkReleaseNotes is string && data.apkReleaseNotes.size() <= 1000)) &&
      data.btebResultUrl is string && data.btebResultUrl.size() <= 600 &&
      data.officialWebsiteUrl is string && data.officialWebsiteUrl.size() <= 600 &&
      data.updatedAt is timestamp;
    }

    // -----------------------------------------------------------------------
    // Collection: /admins/{userId}
    // -----------------------------------------------------------------------
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminMarker(incoming(), userId) &&
        incoming().grantedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminMarker(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedAt']) &&
        incoming().grantedAt == request.time;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // -----------------------------------------------------------------------
    // Collection: /platformNotices/{noticeId}
    // -----------------------------------------------------------------------
    match /platformNotices/{noticeId} {
      allow get: if isValidId(noticeId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(noticeId) &&
        isValidPlatformNotice(incoming(), noticeId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(noticeId) &&
        isValidPlatformNotice(incoming(), noticeId) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'body', 'category', 'officialLink', 'pinned'
        ]);
      allow delete: if isAdmin() && isValidId(noticeId);
    }

    // -----------------------------------------------------------------------
    // Collection: /pushNotifications/{campaignId}
    // -----------------------------------------------------------------------
    match /pushNotifications/{campaignId} {
      allow get: if isSignedIn() && isValidId(campaignId);
      allow list: if isSignedIn();
      allow create: if isAdmin() &&
        isValidId(campaignId) &&
        isValidPushNotificationCampaign(incoming(), campaignId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(campaignId) &&
        isValidPushNotificationCampaign(incoming(), campaignId) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'body', 'category', 'imageUrl', 'targetView', 'actionUrl',
          'audienceType', 'targetUserIds', 'targetDepartment', 'targetSemester',
          'soundMode', 'status', 'totalRecipients'
        ]);
      allow delete: if isAdmin() && isValidId(campaignId);
    }

    // -----------------------------------------------------------------------
    // Collection: /platformFormulas/{formulaId}
    // -----------------------------------------------------------------------
    match /platformFormulas/{formulaId} {
      allow get: if isValidId(formulaId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(formulaId) &&
        isValidPlatformFormula(incoming(), formulaId) &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(formulaId) &&
        isValidPlatformFormula(incoming(), formulaId) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(formulaId);
    }

    // -----------------------------------------------------------------------
    // Collection: /platformSharedNotes/{noteId}
    // -----------------------------------------------------------------------
    match /platformSharedNotes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(noteId) &&
        isValidPlatformSharedNote(incoming(), noteId) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(noteId) &&
        isValidPlatformSharedNote(incoming(), noteId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(noteId);
    }

    // -----------------------------------------------------------------------
    // Collection: /platformMcqs/{mcqId}
    // -----------------------------------------------------------------------
    match /platformMcqs/{mcqId} {
      allow get: if isValidId(mcqId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(mcqId) &&
        isValidPlatformMcq(incoming(), mcqId) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(mcqId) &&
        isValidPlatformMcq(incoming(), mcqId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(mcqId);
    }

    // -----------------------------------------------------------------------
    // Collection: /platformConfig/{configId}
    // -----------------------------------------------------------------------
    match /platformConfig/{configId} {
      allow get: if configId == 'main';
      allow list: if false;
      allow create: if isAdmin() &&
        configId == 'main' &&
        isValidPlatformAppConfig(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        configId == 'main' &&
        isValidPlatformAppConfig(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // Collection: /publicProfiles/{userId} (Non-PII Split Collection)
    // -----------------------------------------------------------------------
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && (existing().profileVisibility != 'private' || isOwner(userId) || isAdmin());
      allow list: if existing().profileVisibility != 'private' || isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming(), userId) &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().role == 'student') ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'department', 'semester', 'collegeName', 'bio',
              'avatarUrl', 'coverUrl', 'profileVisibility', 'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'department', 'semester', 'collegeName', 'bio',
              'avatarUrl', 'coverUrl', 'profileVisibility', 'role', 'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // -----------------------------------------------------------------------
    // Collection: /communityPosts/{postId}
    // -----------------------------------------------------------------------
    match /communityPosts/{postId} {
      allow get: if isValidId(postId) && (existing().isHidden == false || isOwner(existing().authorId) || isAdmin());
      allow list: if existing().isHidden == false || isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidCommunityPost(incoming(), postId) &&
        incoming().authorId == request.auth.uid &&
        incoming().isHidden == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          incoming().authorRole == 'student' ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidCommunityPost(incoming(), postId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Author edits own post or propagates profile updates
          (
            isOwner(existing().authorId) &&
            incoming().isHidden == existing().isHidden &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'subjectTag', 'department', 'semester', 'imageUrl',
              'authorName', 'authorAvatarUrl', 'authorCollegeName', 'authorDepartment',
              'updatedAt'
            ])
          ) ||
          // Action 2: Authenticated student likes or replies
          (
            existing().isHidden == false &&
            incoming().isHidden == existing().isHidden &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'likedByUserIds', 'replies', 'updatedAt'
            ])
          ) ||
          // Action 3: Admin moderation
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isHidden', 'title', 'body', 'likedByUserIds', 'replies', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(postId) &&
        (isOwner(existing().authorId) || isAdmin());
    }

    // -----------------------------------------------------------------------
    // Collection: /users/{userId} (PII Isolated)
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().role == 'student' && (!('isDisabled' in incoming()) || incoming().isDisabled == false)) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            (!('isDisabled' in incoming()) || ('isDisabled' in existing() && incoming().isDisabled == existing().isDisabled)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'department', 'semester', 'collegeName', 'rollNumber', 'bio',
              'avatarUrl', 'coverUrl', 'gender', 'showGender', 'profileVisibility', 'authProvider',
              'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'department', 'semester', 'collegeName', 'rollNumber', 'bio',
              'avatarUrl', 'coverUrl', 'gender', 'showGender', 'profileVisibility', 'authProvider',
              'role', 'isDisabled', 'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      // ---------------------------------------------------------------------
      // Subcollection: /users/{userId}/studyNotes/{noteId}
      // ---------------------------------------------------------------------
      match /studyNotes/{noteId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(noteId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(noteId) &&
          isValidPersonalStudyNote(incoming(), userId, noteId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(noteId) &&
          isValidPersonalStudyNote(incoming(), userId, noteId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'content', 'subjectName', 'department', 'semester', 'updatedAt'
              ])
            ) ||
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'content', 'subjectName', 'department', 'semester', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(noteId) && (isOwner(userId) || isAdmin());
      }

      // ---------------------------------------------------------------------
      // Subcollection: /users/{userId}/pdfCatalog/{pdfId}
      // ---------------------------------------------------------------------
      match /pdfCatalog/{pdfId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(pdfId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(pdfId) &&
          isValidPersonalPdfMetadata(incoming(), userId, pdfId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(pdfId) &&
          isValidPersonalPdfMetadata(incoming(), userId, pdfId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().fileName == existing().fileName &&
          incoming().fileSizeBytes == existing().fileSizeBytes &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'customName', 'department', 'semester', 'subjectCode', 'updatedAt'
              ])
            ) ||
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'customName', 'department', 'semester', 'subjectCode', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(pdfId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
