    "PlatformAppConfig": {
      "title": "PlatformAppConfig",
      "description": "Admin-managed application release settings, APK download link, and BTEB portal links.",
      "type": "object",
      "properties": {
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "apkStatus": {
          "type": "string",
          "enum": ["coming_soon", "available"]
        },
        "apkDownloadUrl": {
          "type": "string",
          "maxLength": 600
        },
        "apkReleaseNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "btebResultUrl": {
          "type": "string",
          "maxLength": 600
        },
        "officialWebsiteUrl": {
          "type": "string",
          "maxLength": 600
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["appVersion", "apkStatus", "btebResultUrl", "officialWebsiteUrl", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated student profile documents containing PII (email, rollNumber) and custom avatar/cover."
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Non-PII split-collection student profile cards (avatar, cover, college, department, bio) for Community."
    },
    "/communityPosts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Student Community posts with likes and replies persisted across all published environments."
    },
    "/users/{userId}/studyNotes/{noteId}": {
      "schema": { "$ref": "#/entities/PersonalStudyNote" },
      "description": "Private personal study notes and saved AI summaries scoped to the owning user."
    },
    "/users/{userId}/pdfCatalog/{pdfId}": {
      "schema": { "$ref": "#/entities/PersonalPdfMetadata" },
      "description": "Private personal PDF catalog metadata scoped to the owning user."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role assignment markers managed strictly by admins."
    },
    "/platformNotices/{noticeId}": {
      "schema": { "$ref": "#/entities/PlatformNotice" },
      "description": "Admin-published platform notices visible to all students across dev and published builds."
    },
    "/pushNotifications/{campaignId}": {
      "schema": { "$ref": "#/entities/PushNotificationCampaign" },
      "description": "Admin-dispatched real-time notification campaigns streamed to signed-in students."
    },
    "/platformFormulas/{formulaId}": {
      "schema": { "$ref": "#/entities/PlatformFormula" },
      "description": "Admin-managed custom formulas for Physics and Mathematics."
    },
    "/platformSharedNotes/{noteId}": {
      "schema": { "$ref": "#/entities/PlatformSharedNote" },
      "description": "Admin-published shared PDF books and notes."
    },
    "/platformMcqs/{mcqId}": {
      "schema": { "$ref": "#/entities/PlatformMcq" },
      "description": "Admin-published MCQ questions."
    },
    "/platformConfig/{configId}": {
      "schema": { "$ref": "#/entities/PlatformAppConfig" },
      "description": "Admin-managed app release and BTEB link configuration."
    }
  }
}
