{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private student or administrator profile document owned by a Firebase Auth user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "semester": {
          "type": "integer",
          "description": "Diploma semester number between 1 and 8."
        },
        "collegeName": {
          "type": "string",
          "maxLength": 160
        },
        "rollNumber": {
          "type": "string",
          "maxLength": 40
        },
        "bio": {
          "type": "string",
          "maxLength": 400
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "gender": {
          "type": "string",
          "enum": ["", "male", "female"]
        },
        "showGender": {
          "type": "boolean"
        },
        "profileVisibility": {
          "type": "string",
          "enum": ["public", "department", "private"]
        },
        "authProvider": {
          "type": "string",
          "enum": ["google", "facebook", "email"]
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"]
        },
        "isDisabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "department",
        "semester",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
