    },
    "PushNotificationCampaign": {
      "title": "PushNotificationCampaign",
      "description": "Admin-dispatched real-time notification campaign delivered to students in-app across devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "body": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "enum": ["APP_UPDATE", "IMPORTANT", "EDUCATION", "EMERGENCY", "GENERAL"]
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "targetView": {
          "type": "string",
          "maxLength": 60
        },
        "actionUrl": {
          "type": "string",
          "maxLength": 500
        },
        "audienceType": {
          "type": "string",
          "enum": ["all", "selected_users", "department_semester"]
        },
        "targetUserIds": {
          "type": "array"
        },
        "targetDepartment": {
          "type": "string",
          "maxLength": 40
        },
        "targetSemester": {
          "type": "integer"
        },
        "soundMode": {
          "type": "string",
          "enum": ["custom", "default", "silent"]
        },
        "status": {
          "type": "string",
          "enum": ["sent", "partial", "failed"]
        },
        "totalRecipients": {
          "type": "integer"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "body",
        "category",
        "audienceType",
        "targetUserIds",
        "soundMode",
        "status",
        "totalRecipients",
        "createdBy",
        "createdAt"
      ]
    },
