          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "semester": {
          "type": "integer"
        },
        "collegeName": {
          "type": "string",
          "maxLength": 160
        },
        "bio": {
          "type": "string",
          "maxLength": 400
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"]
        },
        "profileVisibility": {
          "type": "string",
          "enum": ["public", "department", "private"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "department",
        "semester",
        "role",
        "profileVisibility",
        "updatedAt"
      ]
    },
    "CommunityPost": {
      "title": "CommunityPost",
