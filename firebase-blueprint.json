    "PlatformMcq": {
      "title": "PlatformMcq",
      "description": "Admin-published MCQ question for Quiz and Model Test.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "semester": {
          "type": "integer"
        },
        "questionBn": {
          "type": "string",
          "minLength": 2,
          "maxLength": 600
        },
        "optionsBn": {
          "type": "array"
        },
        "correctIndex": {
          "type": "integer"
        },
        "explanationBn": {
          "type": "string",
