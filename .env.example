# GEMINI_API_KEY: Required for server-side Gemini AI Tutor calls (/api/ai/stream & /api/ai/ask).
# Never expose this key in frontend code (no VITE_ prefix).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where Polytechnic Hub is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC secret used to sign authentication tokens on the server.
# Set a strong random string in production.
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_32_CHARS_MIN"

# Optional server-side Admin bootstrap credentials.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SETUP_SECRET=""

# Supabase Public Configuration (safe for client & server)
# Run supabase/migrations/001_polytechnic_hub_schema.sql, 002_polytechnic_hub_v2_upgrade.sql,
# 003_push_notifications_system.sql, and 004_complete_repair_upgrade.sql in your Supabase SQL Editor.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side only Supabase Service Role Key (for Express/Edge admin push dispatch, NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=""
CRON_SECRET=""

# Firebase Cloud Messaging (FCM) Web Public Configuration (safe for browser/PWA)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""

# Server-side ONLY Firebase Admin Service Account JSON (single-line JSON string, NEVER prefix with VITE_)
# Used by server.ts and Supabase Edge Functions to mint OAuth2 access tokens for FCM HTTP v1 API.
FIREBASE_SERVICE_ACCOUNT_JSON=""
