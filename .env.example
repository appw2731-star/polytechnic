# GEMINI_API_KEY: Required for server-side Gemini AI Tutor calls (/api/ai/ask).
# Never expose this key in frontend code (no VITE_ prefix).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where Polytechnic Hub is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC secret used to sign authentication tokens on the server.
# Set a strong random string in production.
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_32_CHARS_MIN"

# Optional server-side Admin bootstrap credentials.
# If set, the server ensures this admin account exists on startup.
# You can also claim first-time admin via /api/auth/bootstrap-admin when no admin exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SETUP_SECRET=""

# Optional Supabase Configuration (if connecting external Supabase PostgreSQL + Auth)
# Run supabase/migrations/001_polytechnic_hub_schema.sql in your Supabase SQL Editor first.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
